# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=токен_от_BotFather

# Webhook URL (публичный HTTPS адрес)
# На локальной разработке: используйте ngrok и вставьте URL здесь
# На продакшене: URL вашего сервера (например: https://leadbot.onrender.com)
WEBHOOK_URL=https://your-domain.com/webhook

# Google Sheets ID (из URL таблицы)
# Например: если URL https://docs.google.com/spreadsheets/d/1ABC123/edit
# то ID = 1ABC123
GOOGLE_SHEETS_ID=your_sheets_id_here

# Путь к JSON файлу сервисного аккаунта Google
# На Render/сервере: можно положить файл рядом с кодом
# На продакшене: можно вставить JSON содержимое вместо пути
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./service_account.json

# Chat ID менеджера по умолчанию (для уведомлений)
# Получить можно через @userinfobot или в логах бота
MANAGER_CHAT_ID=123456789

# Chat ID администраторов через запятую (для команды /ping)
ADMIN_CHAT_IDS=123456789

# Секретный ключ для вебхука (защита от спама)
# Генерация: python -c "import secrets; print(secrets.token_hex(16))"
WEBHOOK_SECRET=случайная_строка